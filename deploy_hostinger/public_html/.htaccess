# ============================================================================
# CONFIGURACIÓN Y SEGURIDAD RAÍZ - HOSTINGER (REACT SPA + API PHP)
# ============================================================================

# 1. Desactivar listado de directorios
Options -Indexes

# 2. Habilitar motor de reescritura
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # A. Forzar conexión segura HTTPS (SSL)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # B. Preservar cabecera Authorization (JWT en Hostinger/FPM)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # C. Si la petición es hacia la API (/api/...), dejar que la carpeta api la procese
    RewriteRule ^api/ - [L]

    # D. Si el archivo o carpeta existe físicamente (assets, imágenes, etc.), servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # E. Redireccionar cualquier otra ruta a index.html (Soporte para React Router)
    RewriteRule ^ index.html [L]
</IfModule>

# ============================================================================
# PROTOCOLOS DE SEGURIDAD (CABECERAS HTTP)
# ============================================================================
<IfModule mod_headers.c>
    # Prevenir que el sitio sea embebido en iframes de otros dominios (Clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevenir que el navegador adivine el tipo MIME (MIME-sniffing)
    Header set X-Content-Type-Options "nosniff"

    # Habilitar filtro XSS en navegadores antiguos
    Header set X-XSS-Protection "1; mode=block"

    # Control de referencia para privacidad
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Bloquear características de hardware invasivas no utilizadas
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ============================================================================
# PROTECCIÓN DE ARCHIVOS SENSIBLES
# ============================================================================
<FilesMatch "^(\.env|\.git|\.htaccess|\.config|\.sql|\.log|\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ============================================================================
# OPTIMIZACIÓN Y CACHÉ DE NAVEGADOR (Mayor velocidad de carga en Hostinger)
# ============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>

AddDefaultCharset UTF-8
